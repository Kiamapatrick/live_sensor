<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:padding="16dp">

    <!-- Experiment Question -->
    <TextView
        android:id="@+id/tvExperimentQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/experiment_question"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@android:color/darker_gray"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sensor Identity -->
    <TextView
        android:id="@+id/tvSensorIdentity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sensor_not_initialized"
        android:textSize="14sp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvExperimentQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Source Label (MEASURED/SIMULATED) -->
    <TextView
        android:id="@+id/tvSourceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/source_measured"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_green_dark"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSensorIdentity"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Simulated Switch -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchSimulated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/use_simulated_data"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/tvSensorIdentity"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp" />

    <!-- Live Panel: Current Value -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/tvSourceLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRawValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raw: -- lux"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tvSmoothedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smoothed (EMA α=0.2): -- lux"
            android:textSize="18sp"
            android:textColor="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/tvAccuracy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accuracy: --"
            android:textSize="14sp"
            android:textColor="@android:color/holo_red_light" />

        <TextView
            android:id="@+id/tvTiming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timing_initial"
            android:textSize="12sp"
            android:textColor="@android:color/holo_blue_light" />
    </LinearLayout>

    <!-- Smoothing Rule -->
    <TextView
        android:id="@+id/tvSmoothingRule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/smoothing_rule"
        android:textSize="12sp"
        android:textStyle="italic"
        android:padding="8dp"
        android:background="#FFF3E0"
        app:layout_constraintTop_toBottomOf="@id/livePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Condition Selection -->
    <LinearLayout
        android:id="@+id/conditionLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSmoothingRule"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condition: "
            android:textSize="16sp"
            android:layout_gravity="center_vertical" />

        <Spinner
            android:id="@+id/spinnerCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_observation"
            android:layout_marginStart="8dp"
            android:enabled="false" />
    </LinearLayout>

    <!-- Observation Table (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvObservations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/conditionLayout"
        app:layout_constraintBottom_toTopOf="@id/statusLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status Line -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#E8EAF6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvListenerState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/listener_unregistered"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegisterCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register calls: 0 | Unregister calls: 0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvUncalibratedNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uncalibrated_note"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>