<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:weightSum="10">

    <TextView
        android:id="@+id/tvItemTimestamp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="HH:mm:ss.SSS"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tvItemCondition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="Condition"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tvItemRawValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="0.00 lux"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tvItemSmoothedValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="0.00 lux"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tvItemAccuracy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:text="HIGH"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp" />

    <TextView
        android:id="@+id/tvItemSource"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:text="MEASURED"
        android:textSize="11sp"
        android:gravity="center"
        android:padding="2dp"
        android:textStyle="bold" />
</LinearLayout>